PORT=5000
NODE_ENV=development
# Optional custom SQLite database path (default: backend/data/tripwise.db; e.g. /var/data/tripwise.db on Render with persistent disk)
DATABASE_PATH=

# Optional External API Keys (OpenStreetMap & Wikipedia Places work out of the box without keys)
GEOAPIFY_API_KEY=
OPENTRIPMAP_API_KEY=
